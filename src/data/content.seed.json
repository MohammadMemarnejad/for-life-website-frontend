  "aboutContent": {
    "heroTitle": "داستانِ «دَمی برای زیستن»",
    "heroSubtitle": "برای لمس لحظه‌ای زندگی در آشوب روزمرگی",
    "philosophy": {
      "title": "فلسفه ما: مکث در هیاهو و تمرین «آهستگی»",
      "p1": "در دنیایی که همه چیز با سرعتی سرسام‌آور پیش می‌رود و شتاب‌زدگی به عادتی ناگزیر تبدیل شده است، ما اغلب فرصتِ نگاه کردن به آسمان، لذت بردن از لحظات، یا شنیدنِ واقعیِ صدای یک دوست را از دست می‌دهیم.",
      "p2": "«دَمی برای زیستن» پاسخی است به این دل‌تنگیِ عمیق. ما دور هم جمع می‌شویم نه برای سخنرانی‌های سنگین و خسته کننده، بلکه برای ایجاد خلوتی امن و مشترک. اینجا جایی است برای ورق زدن کتاب‌ها، زمزمهٔ شعری که در گلو مانده، و تجربه‌ای از حضور داشتن در لحظه."
    },
    "values": [
      {
        "title": "اصالت و سادگی",
        "desc": "دور از تشریفات و تجملات؛ به سادگی یک استکان چای و یک صفحه شعر."
      },
      {
        "title": "شنیدنِ بدون قضاوت",
        "desc": "در این جمع هر کسی مجالی امن برای بیان احساس و خواندن کلمات دلخواهش دارد."
      },
      {
        "title": "پیوند با هویت و ادبیات",
        "desc": "ادبیات فارسی گنجینه‌ای بی‌پایان برای معنابخشی به لحظه‌های روزمرگی ماست."
      },
      {
        "title": "همدلی و حضور در لحظه",
        "desc": "تجربه عمیق شنیدن و معاشرت در لحظه حضور در دورهمی"
      }
    ],
